'CR350 Program for 2 SDI-12 Sensors + Tipping Bucket + ALERT2 IND/TSD
'Base OS Compatible

'=============================
'   Public Variables
'=============================
PreserveVariables
Public Modem_On As Boolean
Public TB_Scan          'Total tips
Public Precip_Tips
Public Precip_in As Float     'Rain since last scan
Public Test_Precip_Tips As Float

Public Radar_SDI_Address As String
Public Previous_Radar_GH As Float
Public Previous_Bubbler_GH As Float
Public Radar_GH As Float
Public Radar_Offset As Float
Public Radar_Raw As Float

Dim RadarSDI(4)



Public SDI2_Values(2)

Public BattV

Public AL2_IND As String * 256
Public Last_Sent_IND As String * 5


Public Calibrate_SDI As Boolean
Public Force_Measurement As Boolean
Public Force_ALERT2 As Boolean
Public GPS_Clock_Status As Long
Public Test_RS232 As Boolean
Public Test_Alert As Boolean
Public Test_Count As Long
Public Scanning_On As Boolean

Dim dt(9) As Long
Dim Precip_Flag As Boolean
Dim Radar_Flag As Boolean
Dim Bubbler_Flag As Boolean
Dim Tip_Timestamps(61) As Long
Dim Tip_Count As Long
Dim j As Long


'Debug Variables
Public Report_Debug As Float
Public Scan_Step As Long      'Last completed step in slow sequence (0 = not started)
Public Slow_Scan_Count As Long 'Increments every slow-sequence cycle; confirms scan is alive
Public NTP_Result As Long     'Pre-adjustment clock error in ms; negative = PPP/NTP failure


'=============================
'   Constants
'=============================
Const TB_Tip_in = 0.01
Const Site_Lat = 36.1596948
Const Site_Lon = -115.0452761
Const Site_Elevation = 527 '1730 ft to m

'ALERT2 Constants
Const ALERT2_BAUD = 57600
Const ALERT2_COM = Com2
Const StationID = 30235
Const TestStationID = 30299
Const PrecipID = "00"
Const RadarID = "07"
Const BatteryID = "08"
Const GPSID = "10"
Const BubblerID = "09"

Const AL2_Prefix = "414C323262"

'NTP Constants (RV55 via RS-232 on Com1)
Const NTP_COM = Com1
Const NTP_BAUD = 115200
Const NTP_Server = "pool.ntp.org"
Const NTP_UTC_Offset = 0    ' seconds offset from UTC; 0 = keep clock in UTC
Const NTP_Max_Ms = 1000     ' max clock error (ms) before adjustment is applied

'=============================
'   Data Tables
'=============================
DataTable(FiveMinuteData,True,129600)
    DataInterval(0,5,Min,10)
    Sample(1,Precip_Tips,FP2)
    FieldNames("Precip")
    Sample(1,Radar_GH,FP2)
    FieldNames("Gage_Height_Radar")
    Sample(1,SDI2_Values(),FP2)
    FieldNames("Gage_Height_Bubbler")
    Sample(1,BattV,FP2)
    FieldNames("Battery")
    MQTTPublishTable(1, 0, 15, Min, 2, Site_Lon, Site_Lat, Site_Elevation)
EndTable

DataTable(OneMinute,True,129600) '90 Days of Data
  DataInterval(0,1,Min,10)
  Sample(1,Precip_Tips,FP2)
  Sample(1,Radar_GH,FP2)
  Sample(1,SDI2_Values(),FP2)
  Sample(1,BattV,FP2)
EndTable

DataTable(ALERT2_Table, True, 129600)
  Sample(1, AL2_IND, String)
  Sample(1, Last_Sent_IND, String)
  Sample(1,Precip_Tips,FP2)
  Sample(1,Radar_GH,FP2)
  Sample(1,SDI2_Values(),FP2)
  Sample(1,BattV,FP2)
  Sample(1,GPS_Clock_Status,Long)
EndTable


'=============================
'   Includes
'=============================
Include "CPU:Helpers.CRB"
Include "CPU:Sensors.CRB"
Include "CPU:ALERT2.CRB"

'=============================
'   Begin Program
'=============================
BeginProg
    Test_RS232 = False
    Scanning_On = True
    Modem_On = True
    Radar_SDI_Address = "0"

    GPS_Clock_Status = &H3
    SerialOpen(ALERT2_COM, ALERT2_BAUD, 0, 0, 100)
    'Tipping bucket scan every second
    Scan (1,Sec,0,0)
      PulseCount (TB_Scan,1,P_SW,2,0,1.0,0)
      If TB_Scan > 0 Then
        Precip_Flag = True 'Will Send a ALERT2 Event Transmit
        If Test_Alert
          Test_Precip_Tips += TB_Scan
        Else
          Precip_Tips += TB_Scan
          Precip_in = Precip_Tips * TB_Tip_in
        EndIf
        For j = 1 To TB_Scan
          Call Record_Tip_Time
        Next j
      EndIf

      If Force_Measurement OR Calibrate_SDI
        Call Read_Radar
        If Force_Measurement Then
          Radar_Flag = True
        EndIf
        Force_Measurement = False
      EndIf
    NextScan


    'SDI-12 scan every minute
    SlowSequence
      Scan (60, Sec, 0, 0)
        Slow_Scan_Count += 1
        Scan_Step = 1 'Battery
        Battery(BattV)

        Scan_Step = 2 'Read_Radar
        Call Read_Radar

        Scan_Step = 3 'Modem control
        If Modem_On
          SW12 (SW12_1,1)
        Else
          SW12(SW12_1,0)
        EndIf

        Scan_Step = 4 'Radar delta check
        If ABS(Radar_GH - Previous_Radar_GH) > 0.015
          Radar_Flag = True
          Previous_Radar_GH = Radar_GH
        Else
          Previous_Radar_GH = Radar_GH
        EndIf

        Scan_Step = 5 'Read Bubbler
        SDI12Recorder(SDI2_Values(),1,"1","M!",1.0,0)

        If ABS(SDI2_Values(1) - Previous_Bubbler_GH) > 0.015
          Bubbler_Flag = True
        EndIf
        Previous_Bubbler_GH = SDI2_Values(1)

        Scan_Step = 6 'OneMinute table
        CallTable(OneMinute)

        Scan_Step = 7 'GPS query
        GPS_Clock_Status = Query_GPS_Status()

        Scan_Step = 8 'Send_Event_IND (if flagged)
        If Precip_Flag OR Radar_Flag OR Bubbler_Flag
          Call Send_Event_IND
          Precip_Flag = False
          Radar_Flag = False
          Bubbler_Flag = False
        EndIf

        Scan_Step = 9 'Test mode timeout
        If Test_Alert
          Test_Count += 1
        Else
          Test_Count = 0
        EndIf
        If Test_Count > 60
          Test_Alert = False
          Test_Count = 0
        EndIf

        Scan_Step = 10 'Hourly NTP sync + Send_Timed_IND
        If TimeIntoInterval(0,60,Min) Then
          If PPPOpen(NTP_COM, NTP_BAUD, "", "", "", 30, 0, 1) Then
            NTP_Result = NetworkTimeProtocol(NTP_Server, NTP_UTC_Offset, NTP_Max_Ms)
            PPPClose(NTP_COM)
          Else
            NTP_Result = -1  ' PPP connection failed
          EndIf
          Call Send_Timed_IND
        EndIf

        Scan_Step = 11 'FiveMinuteData table
        If TimeIntoInterval(0, 5, Min) Then
          CallTable(FiveMinuteData)
        EndIf

        Scan_Step = 12 'Force_ALERT2
        If Force_ALERT2
          Call Send_Timed_IND
          Force_ALERT2 = False
        EndIf

        Scan_Step = 0 'Scan complete
      NextScan

EndProg
