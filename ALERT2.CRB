'=============================
'   ALERT2 Packet Construction and Transmission
'=============================

Sub Record_Tip_Time
  If Tip_Count < 60 Then
    Tip_Count += 1
    RealTime(dt())
    ' Store seconds-of-day as a Long — avoids SecsSince1990() which returns a 32-bit float
    ' (~128 second precision at current epoch, making all offsets appear as 0).
    Tip_Timestamps(Tip_Count) = dt(4) * 3600 + dt(5) * 60 + dt(6)
  EndIf
EndSub

Sub Clear_Tip_Time
  Dim i As Long
  For i = 1 To 60
    Tip_Timestamps(i) = 0
  Next i
  Tip_Count = 0
EndSub

Sub Send_to_AL200(hexStr As String * 256)
  Dim i As Long
  Dim Chunk As String * 2
  If (Len(hexStr) Mod 2) <> 0 Then Exit Sub
  For i = 1 To Len(hexStr) Step 2
    Chunk = Mid(hexStr, i, 2)
    If Test_RS232
      SerialOut(ALERT2_COM, Chunk, "", 0, 0)
    Else
      SerialOutBlock(ALERT2_COM, HexToDec(Chunk), 1)
    EndIf
  Next i
EndSub

Function Query_GPS_Status() As Long
  ' Queries the AL200 for Clock Status parameter (IND API v2.0, type 0x7F, read-only).
  ' Defined values (range 0, 2-4):
  '   0x0 = accurate GPS time; TDMA media access
  '   0x2 = stale time (set since power-on but has drifted); random/ALOHA media access
  '   0x3 = time never set since power-on; random/ALOHA media access
  '   0x4 = accurate for timestamping only (e.g. NTP), not TDMA; random/ALOHA media access
  ' Returns 0x3 on timeout or parse error — "never set" is the safest unknown state and
  ' correctly signals to the network to use random mode rather than falsely claiming TDMA.
  Dim RxStr As String * 24
  Dim i As Long

  ' Default to 0x3 (time never set) — safer than 0 which would falsely claim GPS lock
  Query_GPS_Status = &H3
  If Test_RS232 Then Exit Function

  ' Flush receive buffer before querying
  SerialFlush(ALERT2_COM)

  ' Get Parameters request: AL22b + total_len=03 + 0B (Get Params) + 01 (len) + 7F (Clock Status)
  SerialOutBlock(ALERT2_COM, &H41, 1)
  SerialOutBlock(ALERT2_COM, &H4C, 1)
  SerialOutBlock(ALERT2_COM, &H32, 1)
  SerialOutBlock(ALERT2_COM, &H32, 1)
  SerialOutBlock(ALERT2_COM, &H62, 1)
  SerialOutBlock(ALERT2_COM, &H03, 1)
  SerialOutBlock(ALERT2_COM, &H0B, 1)
  SerialOutBlock(ALERT2_COM, &H01, 1)
  SerialOutBlock(ALERT2_COM, &H7F, 1)

  ' Read response: 250ms timeout (25 centiseconds), no terminator (0), up to 20 bytes.
  ' SerialIn with a timeout avoids blocking when the AL200 is not connected — the previous
  ' SerialInBlock(... 20) would wait indefinitely for 20 bytes that never arrive.
  SerialIn(RxStr, ALERT2_COM, 25, 0, 20)

  ' Scan for Clock Status TLV (0x7F); byte at i+2 is the clock status value.
  ' Expected response: AL22b (5) + total_len (1) + 0B (1) + content_len (1) + 7F (1) + val_len (1) + val (1) = 11 bytes.
  ' Loop bound is Len(RxStr) (not Len-2) because when GPS status = 0x00, the null value byte
  ' terminates the CRBasic string at length 10 — the 0x7F type byte sits at position 9,
  ' which the old Len-2 bound of 8 never reached. When i+2 exceeds Len, the value was 0x00.
  For i = 1 To Len(RxStr)
    If ASCII(Mid(RxStr, i, 1)) = &H7F Then
      If (i + 2) <= Len(RxStr) Then
        Query_GPS_Status = ASCII(Mid(RxStr, i + 2, 1))
      Else
        Query_GPS_Status = 0  ' value byte was 0x00 (accurate GPS / TDMA mode)
      EndIf
      Exit For
    EndIf
  Next i
EndFunction

Sub Send_Event_IND
  Dim ReportAddress As Long
  Dim AL2_Precip_Val As Long
  Dim address_bytes As String * 16
  Dim IND_Address As String * 24
  Dim Parameter As String * 48
  Dim IND_time As Long
  Dim accum As String * 8
  Dim offsets As String * 128
  Dim TBRG As String * 160
  Dim Sensors As String * 128
  Dim GSR As String * 160
  Dim APDU As String * 256
  Dim SelfReport As String * 256
  Dim Packet As String * 256
  Dim i As Long
  Dim offset As Long

  ' Station address and precip value (test mode aware)
  If Test_Alert
    ReportAddress = TestStationID
    AL2_Precip_Val = Round(Test_Precip_Tips, 0)
  Else
    ReportAddress = StationID
    AL2_Precip_Val = Round(Precip_Tips, 0)
  EndIf

  ' Set Parameters TLV (0x0A) containing IND Address TLV (0x18)
  address_bytes = IntToHexStr(ReportAddress)
  IND_Address = "18" & ByteLength(address_bytes) & address_bytes
  Parameter = "0A" & ByteLength(IND_Address) & IND_Address

  ' Current time for computing tip offsets — seconds-of-day as Long integer
  RealTime(dt())
  IND_time = dt(4) * 3600 + dt(5) * 60 + dt(6)

  ' TBRG (Type 02) — only if precipitation was flagged
  If Precip_Flag
    ' 2-byte accumulator (zero-padded to 4 hex chars)
    accum = IntToHexStr(AL2_Precip_Val)
    While Len(accum) < 4
      accum = "00" & accum
    Wend
    ' 1-byte per-tip offsets (seconds before transmission)
    offsets = ""
    For i = 1 To Tip_Count
      offset = IND_time - Tip_Timestamps(i)
      If offset < 0 Then offset = offset + 86400  ' midnight rollover
      If offset > 255 Then offset = 255
      offsets = offsets & IntToHexStr(offset)
    Next i
    TBRG = "00" & "12" & accum & offsets
    TBRG = "02" & ByteLength(TBRG) & TBRG
  EndIf

  ' GSR (Type 01) — stage sensors if flagged, battery always
  Sensors = ""
  If Radar_Flag
    Sensors = Sensors & SensorReport(RadarID, Round(Radar_GH * 100, 0), "1")
  EndIf
  If Bubbler_Flag
    Sensors = Sensors & SensorReport(BubblerID, Round(SDI2_Values(1) * 100, 0), "1")
  EndIf
  Sensors = Sensors & SensorReport(BatteryID, Round(BattV * 100, 0), "1")
  Sensors = Sensors & SensorReport(GPSID, GPS_Clock_Status, "1")
  GSR = "01" & ByteLength(Sensors) & Sensors

  ' APDU: control byte 0x70 + reports
  If Precip_Flag
    APDU = "70" & TBRG & GSR
  Else
    APDU = "70" & GSR
  EndIf

  ' Self-Report TLV (0x00)
  SelfReport = "00" & ByteLength(APDU) & APDU

  ' Full packet: AL22b prefix + total length + Parameter + SelfReport
  Packet = Parameter & SelfReport
  Packet = AL2_Prefix & ByteLength(Packet) & Packet

  AL2_IND = Packet
  Last_Sent_IND = "Event"
  CallTable(ALERT2_Table)
  Call Send_to_AL200(Packet)
  Call Clear_Tip_Time
EndSub

Sub Send_Timed_IND
  Dim ReportAddress As Long
  Dim AL2_Precip_Val As Long
  Dim address_bytes As String * 16
  Dim IND_Address As String * 24
  Dim Parameter As String * 48
  Dim Sensors As String * 128
  Dim GSR As String * 160
  Dim APDU As String * 192
  Dim SelfReport As String * 224
  Dim Packet As String * 256

  ' Station address and precip value (test mode aware)
  If Test_Alert
    ReportAddress = TestStationID
    AL2_Precip_Val = Round(Test_Precip_Tips, 0)
  Else
    ReportAddress = StationID
    AL2_Precip_Val = Round(Precip_Tips, 0)
  EndIf

  ' Set Parameters TLV (0x0A) containing IND Address TLV (0x18)
  address_bytes = IntToHexStr(ReportAddress)
  IND_Address = "18" & ByteLength(address_bytes) & address_bytes
  Parameter = "0A" & ByteLength(IND_Address) & IND_Address

  ' Sensor reports
  Sensors = SensorReport(PrecipID, AL2_Precip_Val, "1")
  Sensors = Sensors & SensorReport(RadarID, Round(Radar_GH * 100, 0), "1")
  Sensors = Sensors & SensorReport(BubblerID, Round(SDI2_Values(1) * 100, 0), "1")
  Sensors = Sensors & SensorReport(BatteryID, Round(BattV * 100, 0), "1")
  Sensors = Sensors & SensorReport(GPSID, GPS_Clock_Status, "1")

  ' GSR Type 01 TLV
  GSR = "01" & ByteLength(Sensors) & Sensors

  ' APDU: control byte 0x70 + GSR
  APDU = "70" & GSR

  ' Self-Report TLV (0x00)
  SelfReport = "00" & ByteLength(APDU) & APDU

  ' Full packet: AL22b prefix + total length + Parameter + SelfReport
  Packet = Parameter & SelfReport
  Packet = AL2_Prefix & ByteLength(Packet) & Packet

  AL2_IND = Packet
  Last_Sent_IND = "Timed"
  CallTable(ALERT2_Table)
  Call Send_to_AL200(Packet)
  Call Clear_Tip_Time
EndSub
